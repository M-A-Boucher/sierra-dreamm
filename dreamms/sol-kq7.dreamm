    file[]: crc = 68651a0b; size = 203882535; name = RESOURCE.000
    file[]: crc = 6854cf65; size = 217716879; name = RESOURCE.AUD
    file[]: crc = 46b1a190; size =     18697; name = RESOURCE.MAP
