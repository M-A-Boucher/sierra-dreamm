//
// v1.51, CD 
//
game[v1.51-cd]:
    name = v1.51, CD  
    imports = v1.4-cd
    file[]: crc = 485ac6b4; size =    142304; name = 0.CHK
    file[]: crc = 324f1915; size = 206626576; name = RESOURCE.000
    file[]: crc = 2a56277c; size =     18697; name = RESOURCE.MAP
