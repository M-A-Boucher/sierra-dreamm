//
// King’s Quest 7: The Princeless Bride
//
desc[sol-kq7]:

name = King’s Quest 7: The Princeless Bride
icon = sol-kq7.png
machine = pc
osenv = dos
rootpath = C:\SIERRA\KQ7
mips = $(MIPS_P100)
ramkb = 16384
filter = sierra, adventure
LANGUAGE = 1

//
// environment configuration
//
config[environment]:
    title = Environment Configuration
    option[dos]: 
        name = DOS
        launch = $(rootpath)\SIERRA.EXE -o $(rootpath)\RESOURCE.CFG
        condition = file_exists("$$(rootpath)\\SIERRA.EXE")
    end
    option[win]:
        name = Windows
        osenv = windows 3.1
        audiohw = gmidi
        winres = 640x480x8
        launch = $(rootpath)\SIERRAW.EXE -o $(rootpath)\RESOURCE.WIN
        condition = file_exists("$$(rootpath)\\SIERRAW.EXE")
    end
end

//
// sound configuration
//
config[sound]:
    title = Sound Configuration
    condition = is_dos()
    option[sadl]:
        name = $(ADLIB_NAME) + $(SB16_NAME)
        audiohw = adlib+sb16
        SOUND_DRIVER = SADL.DRV
        condition = file_exists("$$(rootpath)\\SADL.DRV")
    end
    option[sb16]:
        name = $(SB16_NAME)
        audiohw = sb16
        SOUND_DRIVER = SBPRO.DRV
        condition = file_exists("$$(rootpath)\\SBPRO.DRV")
    end
    option[mt32]:
        name = $(MT32_NAME)
        audiohw = mt32+sb16
        SOUND_DRIVER = MT32.DRV
        condition = file_exists("$$(rootpath)\\MT32.DRV")
    end
    option[gmidi]:
        name = $(GMIDI_NAME)
        audiohw = gmidi+sb16; priority = 1
        SOUND_DRIVER = GENMIDI.DRV
        condition = file_exists("$$(rootpath)\\GENMIDI.DRV")
    end
end

PATHS = [[[$(CRLF)
    resAud        = $(rootpath)
    resSfx        = $(rootpath)
    audio         = $(rootpath)
    movieDir      = $(rootpath)\AVI
    patchDir      = $(rootpath)\AVI;$(rootpath)
]]]

CFG = [[[$(CRLF)
    videoDrv      = VESA.DRV
    soundDrv      = $(SOUND_DRIVER)
    audioDrv      = DACBLAST.DRV
    joyDrv        = NO
    CD            = NO
    mouseDrv      = NONE
    memoryDrv     = NONE
    minMemory     = 3200k
    audiosize     = 64k
    dacsize       = 30720
    brightness    = 0
    language      = 1
    $(PATHS)
]]]

WIN = [[[$(CRLF)
    [Windows]
    title         = King's Quest VII
    titleBar      = TRUE
    allowresize   = FALSE
    wwidth        = 640
    wheight       = 480
    sciMinK       = 2100
    sciMaxK       = 5000
    borderpixels  = 10
    reservek4     = 700
    reservek8     = 1500
    reservek16    = 2000
    wingMinK      = 2700
    confirmdac    = TRUE
    audioSize     = 62k
    dacSize       = 30720
    synthtype     = highsynth
    language      = $(LANGUAGE)
    $(PATHS)
]]]

script[init]:
    code = [[[$(CRLF)
        if (is_game() && is_dos())
          file_save("$$(rootpath)\\RESOURCE.CFG", "$$(CFG)");

        if (is_game() && is_windows())
          file_save("$$(rootpath)\\RESOURCE.WIN", "$$(WIN)");
    ]]]
end

//
// filesystem
//
mount[]: vpath = C:\        ; srcpath = $(ifsdeltapath)  ; writable = true;
mount[]: vpath = $(rootpath); srcpath = $(ifsinstallpath)

