//
// King’s Quest: Mask of Eternity
//
desc[sol-kq8]:

name = King’s Quest: Mask of Eternity
icon = sol-kq8.png
machine = pc
osenv = windows 95
rootpath = C:\
launch = $(rootpath)\Mask.exe
mips = $(MIPS_MAX)
audiohw = gmidi
filter = sierra

//
// keyboard configuration
//
config[keyboard]:
    title = Keyboard Setup
    option[original]:
        name = Original Preset
        KEYBINDS = [[[$(CRLF)
            KeyChar0=38
            KeyName0=#84
            KeyWord0=up
            KeyChar1=40
            KeyName1=#85
            KeyWord1=down
            KeyChar2=39
            KeyName2=#81
            KeyWord2=right
            KeyChar3=37
            KeyName3=#83
            KeyWord3=left
            KeyChar4=35
            KeyName4=#80
            KeyWord4=end
            KeyChar5=45
            KeyName5=#82
            KeyWord5=insert
            KeyChar6=46
            KeyName6=#86
            KeyWord6=delete
            KeyChar7=36
            KeyName7=#92
            KeyWord7=home
            KeyChar8=9
            KeyName8=#93
            KeyWord8=tab
            KeyChar9=16
            KeyName9=#89
            KeyWord9=shift
            KeyChar10=17
            KeyName10=#90
            KeyWord10=control
            KeyChar11=18
            KeyName11=#106
            KeyWord11=alt
            KeyChar12=32
            KeyName12=#91
            KeyWord12=space
        ]]]
    end
    option[modern]:
        name = Modern Preset
        KEYBINDS = [[[$(CRLF)
            KeyChar0=87
            KeyName0=W
            KeyWord0=w
            KeyChar1=83
            KeyName1=S
            KeyWord1=s
            KeyChar2=68
            KeyName2=D
            KeyWord2=d
            KeyChar3=65
            KeyName3=A
            KeyWord3=a
            KeyChar4=16
            KeyName4=#89
            KeyWord4=shift
            KeyChar5=32
            KeyName5=#91
            KeyWord5=space
            KeyChar6=81
            KeyName6=Q
            KeyWord6=q
            KeyChar7=36
            KeyName7=#92
            KeyWord7=home
            KeyChar8=77
            KeyName8=M
            KeyWord8=m
            KeyChar9=69
            KeyName9=E
            KeyWord9=e
            KeyChar10=17
            KeyName10=#90
            KeyWord10=control
            KeyChar11=18
            KeyName11=#106
            KeyWord11=alt
            KeyChar12=9
            KeyName12=#93
            KeyWord12=tab
            KeyName12=#91
            KeyWord12=space
        ]]]
    end
end

//
// renderer configuration
//
config[renderer]:
    title = Renderer Configuration
    option[software]:
        name = Software
        winres = 640x480x16
        MODE = [[[$(CRLF)
            setShadowMask 5
            useDynamicLighting 1
            assignGModeName Software
        ]]]
    end
    option[hardware]:
        name = Direct3D
        winres = 640x480x16; priority = 1
        MODE = [[[$(CRLF)
            setShadowMask 0
            useDynamicLighting 0
            assignGModeName D3D-display
        ]]]
    end
end

MASK = [[[$(CRLF)
    [Install]
    Drive=C:\
]]]

MAIN = [[[$(CRLF)
    [Window]
    classType=KQMainWindow
    x=0
    y=0
    numRasters=3000
    background=0
    aviPlayed=0
    shutDownOK=1
]]]

OPTIONS = [[[$(CRLF)
    KQSound::setSpeechVol 1
    KQSound::setSfxVol    1
    KQSound::setMusicVol  1
    set Options::Captions true
    notStartingHelp 0
    setBrightness 48
    set800mode 0
    $(MODE)
]]]

MOVEKEYS = [[[$(CRLF)
    [MovekeysScreen]
    classType=KQMoveKeysScreen
    guiFile=Movekey.gui
    palette=Menus.ppl
    volume=game / $KQGame::BitDepth GUI
    bgColor=0
    useWorldPal=0
    cursor=IDBMA_CURSGUI
    moveSound=click.aud
    selectSound=intrface.aud
    $(KEYBINDS)
]]]

script[init]:
    code = [[[$(CRLF)
        file_save("$$(rootpath)\\MASK.INF", "$$(MASK)");
        file_save("$$(rootpath)\\OPTIONS.CS", "$$(OPTIONS)");
        file_save("$$(rootpath)\\MOVEKEYS.KQ", "$$(MOVEKEYS)");

        if (!file_exists("$$(rootpath)\\MAIN.KQ"))
          file_save("$$(rootpath)\\MAIN.KQ", "$$(MAIN)");
    ]]]
end

//
// filesystem
//
mount[]: vpath = C:\        ; srcpath = $(ifsdeltapath)  ; writable = true
mount[]: vpath = $(rootpath); srcpath = $(ifsinstallpath)

//
// v1.0
