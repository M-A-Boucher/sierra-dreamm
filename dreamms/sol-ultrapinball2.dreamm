//
// 3-D Ultra Pinball: Creep Night
//
desc[sol-ultrapinball2]:

name = 3-D Ultra Pinball: Creep Night
icon = sol-ultrapinball2.png
machine = pc
osenv = windows
winres = 800x600x8
rootpath = C:\
launch = $(rootpath)\PINBALL2.EXE
audiohw = gmidi
mips = $(MIPS_MAX)
filter = sierra, dynamix, pinball

INI = [[[$(CRLF)
    [UPBALL]
    InstallPath=C:\
    CDPath=C:\
]]]

PINBALL2 = [[[$(CRLF)
    [Sound]
    SoundCard=1
    MusicType=1
    Volume=85

    [Display]
    ScreenWidth=800
    ScreenHeight=600
    ColorDepth=8
    Fullscreen=1

    [Controls]
    Left=P
    Right=K
    FlipperLeft=L
    FlipperRight=O
    LaunchSpace=SPACE
]]]

script[init]:
    code = [[[$(CRLF)
        file_save("$$(rootpath)\\SIERRA.INI", "$$(INI)");
        file_save("$$(rootpath)\\PINBALL2.INI", "$$(PINBALL2)");
    ]]]
end

//
// file system
//
mount[]: vpath = C:\        ; srcpath = $(ifsdeltapath)     ; writable = true
mount[]: vpath = $(rootpath); srcpath = $(ifsinstallpath)
mount[]: vpath = D:\        ; srcpath = $(ifsinstallpath)\CD

//
// 1996
//
game[1996]:
