//
// 3-D Ultra Pinball: NASCAR Pinball
//
desc[sol-ultrapinball4]:

name = 3-D Ultra Pinball: NASCAR Pinball
icon = sol-ultrapinball4.png
machine = pc
osenv = windows
rootpath = C:\
launch = $(rootpath)\Pinball.exe
audiohw = gmidi
filter = sierra, dynamix, pinball

//
// file system
//
mount[]: vpath = C:\        ; srcpath = $(ifsdeltapath)  ; writable = true
mount[]: vpath = $(rootpath); srcpath = $(ifsinstallpath)

//
// v1.0
//
