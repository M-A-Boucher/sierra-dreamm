//
// The Incredible Machine 3
//
desc[sol-tim3]:

name = The Incredible Machine 3
icon = sol-tim3.png
machine = pc
osenv = windows
rootpath = C:\
launch = $(rootpath)\TIMWIN.EXE
winres = 1024x768x8
mips = $(MIPS_MAX)
audiohw = gmidi
filter = dynamix, sierra, puzzle

INI = [[[$(CRLF)
    [TimWin]
    InstallPath=C:\
    CDPath=D:\
]]]

script[init]:
    code = [[[$(CRLF)
        file_save("$$(rootpath)\\SIERRA.INI", "$$(INI)");
    ]]]
end

//
// filesystem
//
mount[]: vpath = C:\        ; srcpath = $(ifsdeltapath)     ; writable = true
mount[]: vpath = $(rootpath); srcpath = $(ifsinstallpath)
mount[]: vpath = D:\        ; srcpath = $(ifsinstallpath)\CD; optional = true

//
// v1.0
//
game[v1.0]:
    name = v1.0
    anchorfile = TIMWIN.EXE
    anchordepth = 1
    file[]: crc = f7cb253c; size =     14416; name = CTL3D.DLL
