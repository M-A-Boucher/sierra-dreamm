//
// 3-D Ultra: Cool Pool
//
desc[sol-ultrapool]:

name = 3-D Ultra: Cool Pool
icon = sol-ultrapool.png
machine = pc
osenv = windows
rootpath = C:\
launch = $(rootpath)\coolpool.exe
audiohw = gmidi
filter = sierra, dynamix

//
// file system
//
mount[]: vpath = C:\        ; srcpath = $(ifsdeltapath)     ; writable = true
mount[]: vpath = $(rootpath); srcpath = $(ifsinstallpath)

//
// v1.0
//
