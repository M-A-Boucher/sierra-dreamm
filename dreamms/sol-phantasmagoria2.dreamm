//
// Phantasmagoria: A Puzzle of Flesh
//
desc[sol-phantasmagoria2]:

name = Phantasmagoria: A Puzzle of Flesh
icon = sol-phantasmagoria2.png
machine = pc
osenv = windows
rootpath = C:\
launch = $(rootpath)\SIERRAW.EXE
mips = $(MIPS_MAX)
audiohw = gmidi
filter = sierra, adventure

WIN = [[[$(CRLF)
    [Windows]
    title         = Phantasmagoria - A Puzzle of Flesh
    titleBar      = TRUE
    titleBarFixed = FALSE
    allowresize   = FALSE
    maximized     = TRUE
    wwidth        = 640
    wheight       = 480
    sciMinK       = 9000
    sciMaxK       = 9000
    borderpixels  = 10
    reservek4     = 700
    reservek8     = 700
    reservek16    = 2000
    wingMinK      = 2700
    confirmdac    = TRUE
    leadSubmits   = 4
    colorCursor   = TRUE
    maxCursorSize = 2016
    palette       = $(rootpath)\DUK
    resAud        = $(rootpath)
    resSfx        = $(rootpath)
    resMap        = $(rootpath)
    resCDisc      = $(rootpath)
    patchDir      = $(rootpath);$(rootpath)\PATCHES
    movieDir      = $(rootpath)\DUK
    robot         = $(rootpath)\ROBOT
    discID        = RESSCI
    CD:           = $(rootpath)
]]]

script[init]: code = file_save("$$(rootpath)\\RESOURCE.WIN", "$$(WIN)")

//
// filesystem
//
mount[]: vpath = C:\        ; srcpath = $(ifsdeltapath)  ; writable = true
mount[]: vpath = $(rootpath); srcpath = $(ifsinstallpath)

//
// v1.0
//
