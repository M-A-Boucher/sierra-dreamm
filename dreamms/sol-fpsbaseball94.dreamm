//
// Front Page Sports: Baseball ’94
//
desc[sol-fpsbaseball94]:

name = Front Page Sports: Baseball ’94
icon = sol-fpsbaseball94.png
machine = pc
osenv = dos
rootpath = C:\SIERRA\BASEBALL
launch = PLAYBALL.COM
mips = $(MIPS_486DX4_100)
videohw = svga
ramkb = 8192
filter = sierra

//
// File System
//
mount[]: vpath = C:\;         srcpath = $(ifsdeltapath); writable = true;
mount[]: vpath = $(rootpath); srcpath = $(ifsinstallpath)

INSTALL = [[[$(CRLF)
    UNCHUNK RESOURCE.000 .
    UNCHUNK RESOURCE.001 .
    UNCHUNK RESOURCE.002 .
    UNCHUNK RESOURCE.003 .
]]]

UPGRADE = [[[$(CRLF)
    UNCHUNK XPANSTAD.RES .
    UNCHUNK XPANTEAM.RES .
    PATCH PATCHA.RTP
    PATCH PATCHB.RTP
    PATCH PATCHC.RTP
    PATCH PATCHD.RTP ASSN
    PATCH PATCHE.RTP STADIA
    PATCH PATCHG.RTP
    PATCH PATCHH.RTP
    PATCH PATCHI.RTP ASSN
]]]

CFG = [[[$(CRLF)
    space       = 18432
    directory   = \SIERRA\BASEBALL
    cmd         = playball
    joyDrv      = none
    mouseDrv    = none
    memoryDrv   = none
    minCPU      = 386
    minDOS      = 500
    minEMS      = 2560
    mode        = real

    [SoundFX]
    Driver#     = e015
    DMA         = 1
    IRQ         = 7
    PortAddress =220
    [Music]
    Driver#     = a002
    PortAddress = 388
]]]

script[init]:
    code = [[[$(CRLF)
        if (is_installer())
          file_save("$$(rootpath)\\DREAMM.BAT", "$$(INSTALL)");

        if (is_upgrader())
          file_save("$$(rootpath)\\DREAMM.BAT", "$$(UPGRADE)");

        if (is_game())
          file_save("$$(rootpath)\\RESOURCE.CFG", "$$(CFG)");
    ]]]
end

