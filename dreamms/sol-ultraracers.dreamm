//
// 3-D Ultra: Radio Control Racers
//
desc[sol-ultraracers]:

name = 3-D Ultra: Radio Control Racers
icon = sol-ultraracers.png
machine = pc
osenv = windows
rootpath = C:\
launch = $(rootpath)\RCRacers.exe
audiohw = gmidi
filter = sierra, dynamix, simulation, action, racing

//
// resolution configuration
//
config[resolution]:
    title = Resolution Configuration
    option[800x600]: 
        name = 800×600
        winres = 800x600x16
    end
    option[1024x768]:
        name = 1024×768
        winres = 1024x768x16
    end
end

script[init]:
    code = [[[$(CRLF)
        drive_set_label("D", "RCDELUXE");
    ]]]
end

//
// file system
//
mount[]: vpath = C:\        ; srcpath = $(ifsdeltapath)     ; writable = true
mount[]: vpath = $(rootpath); srcpath = $(ifsinstallpath)
mount[]: vpath = D:\        ; srcpath = $(ifsinstallpath)\CD; condition = file_exists("$$(rootpath)\\CD\\CDDA.SOU")

//
// v1.0
//
game[v1.0]:
    name = v1.0
    anchorfile = RCRacers.exe
    anchordepth = 1
