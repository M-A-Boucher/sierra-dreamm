//
// The Incredible Machine
//
desc[sol-tim1]:

name = The Incredible Machine
icon = sol-tim1.png
machine = pc
osenv = dos
rootpath = C:\
launch = $(rootpath)\TIM.EXE
mips = $(MIPS_486DX2_66)
ramkb = 8192
filter = dynamix, sierra, puzzle
videohw = vga

//
// sound configuration
//
config[sound]:
    title = Sound Configuration
    condition = is_dos()
    option[speaker]:
        name = $(SPEAKER_NAME)
        audiohw = speaker
        AUDIO = 00
    end
    option[adlib]:
        name = $(ADLIB_NAME)
        audiohw = adlib; priority = 1
        AUDIO = 02
    end
end

script[init]:
    code = [[[$(CRLF)
        file_save("$$(rootpath)\\RESOURCE.CFG", "`h:02 $(AUDIO) FE");
        mouse_force_relative_zero(true);
    ]]]
end

//
// filesystem
//
mount[]: vpath = C:\        ; srcpath = $(ifsdeltapath)     ; writable = true
mount[]: vpath = $(rootpath); srcpath = $(ifsinstallpath)

//
// copy protection script
//
$(include cp-tim1.inc)

//
// v1.0, 1x1.44M
//
game[v1.0-1x1.44m]:
    name = v1.0, 1x1.44M
    anchorfile = TIM.EXE 
    file[]: crc = 92f60a37; size =       740; name = CATOMATC.TIM
    file[]: crc = c318e1e1; size =      3376; name = MOUSE.TIM
    file[]: crc = ba580f9d; size =    196578; name = RESOURCE.001
    file[]: crc = 72117e09; size =    163032; name = RESOURCE.002
    file[]: crc = 1e1b1424; size =    220123; name = RESOURCE.003
    file[]: crc = c118556c; size =      2815; name = RESOURCE.004
    file[]: crc = dbda03c4; size =      1338; name = RESOURCE.MAP
    file[]: crc = f7a50b12; size =    111951; name = TIM.EXE
    file[]: crc = 3afeb2e5; size =      1046; name = TONSOFUN.TIM
end

//
// Demo
//
demo[demo]:
    name = Demo
    osenv = windows 3.1
    audiohw = gmidi
    winres = 640x480x8
    launch = $(rootpath)\TIMDEMO.EXE
    anchorfile = TIMDEMO.EXE 
    file[]: crc = c6253742; size =      5653; name = TIM.MID
    file[]: crc = bcceb31c; size =    566392; name = TIM16.PRS
    file[]: crc = 74bf9cf1; size =     15606; name = TIM_CRBN.MID
    file[]: crc = 879f4554; size =     33253; name = TIM_EURO.MID
    file[]: crc = e4626227; size =     23864; name = TIM_FUNK.MID
    file[]: crc = 4bb8d2df; size =     25487; name = TIM_FUSN.MID
    file[]: crc = 3ae29e4c; size =     17873; name = TIM_JNGL.MID
    file[]: crc = a14a7fe3; size =     16666; name = TIM_REGG.MID
    file[]: crc = d619e948; size =      6123; name = TIM_WEST.MID
    file[]: crc = e040bfa2; size =    303104; name = TIMDEMO.EXE
    file[]: crc = 417d4727; size =    251079; name = TIMWIN.PRS
end

end