//
// The Incredible Machine: Even More Contraptions
//
desc[sol-tim5]:

name = The Incredible Machine: Even More Contraptions
icon = sol-tim5.png
machine = pc
osenv = windows 98
rootpath = C:\
launch = $(rootpath)\EvenMore.exe
audiohw = gmidi
winres = 800x600x16
filter = sierra, dynamix, puzzle

//
// filesystem
//
mount[]: vpath = C:\        ; srcpath = $(ifsdeltapath)     ; writable = true
mount[]: vpath = $(rootpath); srcpath = $(ifsinstallpath)
mount[]: vpath = D:\        ; srcpath = $(ifsinstallpath)\CD

