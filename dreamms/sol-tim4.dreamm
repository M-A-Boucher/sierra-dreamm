//
// Return of The Incredible Machine: Contraptions
//
desc[sol-tim4]:

name = Return of The Incredible Machine: Contraptions
icon = sol-tim4.png
machine = pc
osenv = windows 98
rootpath = C:\
launch = $(rootpath)\Contraptions.exe
audiohw = gmidi
winres = 800x600x16
filter = sierra, dynamix, puzzle

//
// filesystem
//
mount[]: vpath = C:\        ; srcpath = $(ifsdeltapath)     ; writable = true
mount[]: vpath = $(rootpath); srcpath = $(ifsinstallpath)
mount[]: vpath = D:\        ; srcpath = $(ifsinstallpath)\CD

game[v1.0]:
    name = v1.0
    anchorfile = Contraptions.exe
    anchordepth = 1
