//
// Leisure Suit Larry: Love for Sail!
//
desc[sol-lsl7]:

name = Leisure Suit Larry: Love for Sail!
icon = sol-lsl7.png
machine = pc
osenv = dos
rootpath = C:\SIERRA\LSL7
mips = $(MIPS_P100)
ramkb = 16384
audiohw = sb16
filter = sierra, adventure

//
// environment configuration
//
config[environment]:
    title = Environment Configuration
    option[dos]: 
        name = DOS
        launch = $(rootpath)\SIER.EXE
        condition = file_exists("$$(rootpath)\\SIER.EXE")
    end
    option[win]:
        name = Windows
        osenv = windows 95
        audiohw = gmidi
        launch = $(rootpath)\SIERW5.EXE
        condition = file_exists("$$(rootpath)\\SIERW5.EXE")
    end
end

//
// sound configuration
//
config[sound]:
    title = Sound Configuration
    option[8bit]:
        name = Mono
        AUDIOPATH = MUSIC\22M8
        condition = file_exists("$$(rootpath)\\MUSIC\\22M8\\10000.AUD")
    end
    option[16bit]:
        name = Stereo; priority = 1
        AUDIOPATH = MUSIC\22S16
        condition = file_exists("$$(rootpath)\\MUSIC\\22S16\\10000.AUD")
    end
end

PATHS = [[[$(CRLF)
    resMap         = $(rootpath)
    resAud         = $(rootpath)
    resSfx         = $(rootpath)
    audio          = $(rootpath)\$(AUDIOPATH)
    movieDir       = $(rootpath)\MOVIE
    patchDir       = $(rootpath)\PATCHES
]]]

CFG = [[[$(CRLF)
    videoDrv       = VESA.DRV
    soundDrv       = MIDNONE.DRV
    audioDrv       = DACBLAST.DRV
    joyDrv         = NO
    CD             = NO
    mouseDrv       = NONE
    memoryDrv      = NONE
    minMemory      = 3200k
    audioSize      = 32k
    dacsize        = 30720
    brightness     = 0
    language       = 1
    $(PATHS)
]]]



WIN = [[[$(CRLF)
    [Windows]
    title          = Leisure Suit Larry in 'Love For Sail!'
    wwidth         = 640
    wheight        = 480
    allowresize    = FALSE
    borderpixels   = 0
    sciMinK	   = 3200
    sciMaxK        = 5400
    winG           = FALSE
    confirmdac     = TRUE
    usemidi	   = TRUE
    useaudio       = TRUE
    leadSubmits    = 4
    minSubmits     = 8
    maxSubmits     = 32
    useDirectSound = TRUE
    useDirectDraw  = TRUE
    VideoSpeed     = 300
    cacheSize2     = 750
    cacheSize3     = 350
    $(PATHS)
]]]

script[init]:
    code = [[[$(CRLF)
        if (is_dos())
          file_save("$$(rootpath)\\RESOURCE.CFG", "$$(CFG)");

        if (is_windows())
          file_save("$$(rootpath)\\RESOURCE.WIN", "$$(WIN)");
    ]]]
end

//
// filesystem
//
mount[]: vpath = C:\;         srcpath = $(ifsdeltapath); writable = true
mount[]: vpath = $(rootpath); srcpath = $(ifsinstallpath);

