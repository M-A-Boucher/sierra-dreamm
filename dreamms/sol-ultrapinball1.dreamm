//
// 3-D Ultra Pinball
//
desc[sol-ultrapinball1]:

name = 3-D Ultra Pinball
icon = sol-ultrapinball1.png
machine = pc
osenv = windows
winres = 800x600x8
rootpath = C:\
launch = $(rootpath)\PINBALL.EXE
audiohw = gmidi
mips = $(MIPS_MAX)
filter = sierra, dynamix, pinball

//
// file system
//
mount[]: vpath = C:\; srcpath = $(ifsdeltapath)  ; writable = true
mount[]: vpath = C:\; srcpath = $(ifsinstallpath)
mount[]: vpath = D:\; srcpath = $(ifsinstallpath)\CD

INI = [[[$(CRLF)
    [UPBALL]
    InstallPath=C:\
    CDPath=C:\
]]]

PINBALL = [[[$(CRLF)
    [Sound]
    SoundCard=1
    MusicType=1
    Volume=85

    [Display]
    ScreenWidth=800
    ScreenHeight=600
    ColorDepth=8
    Fullscreen=1

    [Controls]
    Left=P
    Right=K
    FlipperLeft=L
    FlipperRight=O
    LaunchSpace=SPACE
]]]

script[init]:
    code = [[[$(CRLF)
        file_save("$$(rootpath)\\SIERRA.INI", "$$(INI)");
        file_save("$$(rootpath)\\PINBALL.INI", "$$(PINBALL)");
    ]]]
end

//
// 1995
//
game[1995]:
