script[cp]:
    code = [[[$(CRLF)
        cpactive = "";
        answer = "";

        func update()
        {
          echo(scraper_fingerprint("BYNUzlznX"));

          if (!script_running(cpscript))
          {
            answer = scraper_match("BYNUzlznX", "$$(FINGERPRINTS)");

            if (answer != "")
            {
              echo("Answer: " + answer);

              if (!prop("noautocp"))
                cpscript = script_run_async("cpauto", answer+"\r");

              if (!prop("notextcp"))
                overlay_show("cpoverlay", 1, "This lovely lady’s number is 555-" + answer);
            }
            else
            {
              cpactive = false;
              overlay_hide("cpoverlay");
            }
          }
        }

        func cpauto(value)
        {
          input_lockout(true);
          sleep(1000);
          keyboard_type(value);
          sleep(500);
          input_lockout(false);
        }
    ]]]
end
