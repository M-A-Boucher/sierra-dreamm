//
// Jones in the Fast Lane
//
desc[sol-jones]:

name = Jones in the Fast Lane
icon = sol-jones.png
machine = pc
osenv = dos
rootpath = C:\
mips = $(MIPS_486DX_33)
ramkb = 4096
audiohw = $(AUDIOHW)+$(SFX)
filter = sierra, strategy
TANDY = 0
AUDIO_DRIVER = $(NULL)

//
// environment configuration
//
config[environment]:
    title = Environment Configuration
    option[dos-vga]: 
        name = DOS
        launch = $(rootpath)\SCIV256.EXE
        condition = file_exists("$$(rootpath)\\SCIV256.EXE")
    end
    option[dos-ega]: 
        name = DOS
        launch = $(rootpath)\SCIV.EXE
        condition = file_exists("$$(rootpath)\\SCIV.EXE")
    end
    option[dos-cd]: 
        name = DOS
        launch = $(rootpath)\SCIDHUV.EXE
        condition = file_exists("$$(rootpath)\\SCIDHUV.EXE")
    end
    option[win]:
        name = Windows
        osenv = windows 3.1
        mips = $(MIPS_MAX)
        launch = $(rootpath)\SCIJONES.EXE
        condition = file_exists("$$(rootpath)\\SCIJONES.EXE")
    end
end

//
// graphics configuration
//
config[graphics]:
    title = Graphics Configuration
    option[tandy]: 
        name = $(TVIDEO_NAME)
        videohw = cga; machine = tandy
        VIDEO_DRIVER = TANDY320.DRV; SOUND_DRIVER = TANDY3V.DRV; TANDY = 1
        condition = file_exists("$$(rootpath)\\TANDY320.DRV") && file_exists("$$(rootpath)\\TANDY3V.DRV")
    end
    option[ega]:
        name = $(EGA_NAME)
        videohw = ega; priority = 1
        VIDEO_DRIVER = EGA320.DRV
        condition = file_exists("$$(rootpath)\\EGA320.DRV")
    end
    option[mcga]:
        name = $(MCGA_NAME)
        videohw = mcga
        VIDEO_DRIVER = MCGA320.DRV
        condition = file_exists("$$(rootpath)\\MCGA320.DRV")
    end
    option[vga]:
        name = $(VGA_NAME);
        videohw = vga; priority = 2
        VIDEO_DRIVER = VGA320.DRV
        condition = file_exists("$$(rootpath)\\VGA320.DRV")
    end
end

//
// sound configuration
//
config[sound]:
    title = Sound Configuration
    condition = !$(TANDY)
    option[speaker]:
        name = $(SPEAKER_NAME)
        SOUND_DRIVER = STD.DRV; AUDIOHW = speaker
        condition = file_exists("$$(rootpath)\\STD.DRV")
    end
    option[cms]:
        name = $(CMS_NAME)
        SOUND_DRIVER = CMS.DRV; AUDIOHW = cms
        condition = file_exists("$$(rootpath)\\CMS.DRV")
    end
    option[adlib]:
        name = $(ADLIB_NAME); priority = 1
        SOUND_DRIVER = ADL.DRV; AUDIOHW = adlib;
        condition = file_exists("$$(rootpath)\\ADL.DRV")
    end
    option[sb16]:
        name = $(SB16_NAME)
        SOUND_DRIVER = SNDBLAST.DRV; AUDIOHW = sb16
        condition = file_exists("$$(rootpath)\\SNDBLAST.DRV")
    end
    option[mt32]:
        name = $(MT32_NAME)
        SOUND_DRIVER = MT32.DRV; AUDIOHW = mt32
        condition = file_exists("$$(rootpath)\\MT32.DRV")
    end
end

//
// sfx configuration
//
config[sfx]:
    title = SFX Configuration
    condition = is_dos()
    option[on]:
        name = On
        AUDIO_DRIVER = AUDBLAST.DRV; SFX = sb16
        condition = file_exists("$$(rootpath)\\AUDBLAST.DRV")
    end
    option[off]:
        name = Off
        AUDIO_DRIVER = $(NULL); SFX = $(NULL)
        condition = !file_exists("$$(rootpath)\\AUDCDROM.DRV")
    end
end

CFG = [[[$(CRLF)
    videoDrv  = $(VIDEO_DRIVER)
    soundDrv  = $(SOUND_DRIVER)
    audioDrv  = $(AUDIO_DRIVER)
    joyDrv    = JOYSTICK.DRV
    kbdDrv    = IBMKBD.DRV
    mouseDrv  = STDMOUSE.DRV
    memoryDrv = ARM.DRV
    minHunk   = 250k
    patchDir  = .
]]]

script[init]:
    code = [[[$(CRLF)
        file_save("$$(rootpath)\\RESOURCE.CFG", "$$(CFG)");
    ]]]
end

//
// filesystem
//
mount[]: vpath = C:\        ; srcpath = $(ifsdeltapath)     ; writable = true;
mount[]: vpath = $(rootpath); srcpath = $(ifsinstallpath)
mount[]: vpath = D:\        ; srcpath = $(ifsinstallpath)\CD; condition = file_exists("$$(rootpath)\\AUDCDROM.DRV")

//
// v1.000.060, Int. 10.19.90, 1x1.2M
