//
// Red Baron
//
desc[sol-redbaron]:

name = Red Baron
icon = sol-redbaron.png
machine = pc
osenv = dos
rootpath = C:\
launch = $(rootpath)\BARON.COM
mips = $(MIPS_486DX_33)
ramkb = 8192
filter = dynamix, action
videohw = vga
VIDEO = 8 // VGA 256 colors
IS_EGA = false

config[sound]:
    title = Sound Configuration
    option[speaker]:
        name = $(SPEAKER_NAME) 
        audiohw = speaker
        AUDIO = 0
    end
    option[adlib]:
        name = $(ADLIB_NAME)
        audiohw = adlib; priority = 1
        AUDIO = 2
    end
    option[sb16]:
        name = $(SB16_NAME)
        audiohw = sb16
        AUDIO = 4
    end
    option[mt32]:
        name = $(MT32_NAME)
        audiohw = mt32
        AUDIO = 3
    end
end

config[video]:
    title = Video Configuration
    condition = $(IS_EGA)
    // Installer mentions "MCGA" but is the same as regular CGA
    // Also mentions VGA (16 color) but is the same as EGA
    option[cga]:
        name = $(CGA_NAME)
        videohw = cga
        VIDEO = 1
    end
    option[ega]:
        name = $(EGA_NAME)
        videohw = ega; priority = 1
        VIDEO = 2
    end
end

script[init]:
    code = [[[$(CRLF)
        file_save("$$(rootpath)\\CONTROL.PRF", "`h:$$(VIDEO) $$(AUDIO) 00 01 01 01");
    ]]]
end

//
// filesystem
//
mount[]: vpath = C:\        ; srcpath = $(ifsdeltapath)  ; writable = true
mount[]: vpath = $(rootpath); srcpath = $(ifsinstallpath)

