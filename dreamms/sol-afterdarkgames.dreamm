desc[sol-afterdarkgames]:

name = After Dark Games
icon = sol-afterdarkgames.png
machine = pc
rootpath = C:\SIERRA\After Dark Games
launch = "$(rootpath)\After Dark Games.exe"
osenv = windows 98
winres = 640x480x16
filter = sierra, action

//
// filesystem
//
mount[]: vpath = C:\        ; srcpath = $(ifsdeltapath)  ; writable = true
mount[]: vpath = $(rootpath); srcpath = $(ifsinstallpath)

//
// 
//
