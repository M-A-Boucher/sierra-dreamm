//
// 3-D Ultra Pinball: The Lost Continent
//
desc[sol-ultrapinball3]:

name = 3-D Ultra Pinball: The Lost Continent
icon = sol-ultrapinball3.png
machine = pc
osenv = windows
winres = 640x480x32
rootpath = C:\
launch = $(rootpath)\Pinball3.exe
audiohw = gmidi
filter = sierra, dynamix, pinball

//
// file system
//
mount[]: vpath = C:\        ; srcpath = $(ifsdeltapath)     ; writable = true
mount[]: vpath = $(rootpath); srcpath = $(ifsinstallpath)

//
// v1.0
//
