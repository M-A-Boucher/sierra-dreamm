//
// Hoyle Card Games ’99
//
desc[sol-hoylecard2]:

name = Hoyle Card Games ’99
icon = sol-hoylecard2.png
machine = pc
osenv = windows
rootpath = C:\
launch = $(rootpath)\HCCG2.EXE
audiohw = gmidi
filter = sierra, tabletop, card

//
// filesystem
//
mount[]: vpath = C:\        ; srcpath = $(ifsdeltapath)     ; writable = true;
mount[]: vpath = $(rootpath); srcpath = $(ifsinstallpath)
mount[]: vpath = D:\        ; srcpath = $(ifsinstallpath)\CD

//
// v1.0
//
game[v1.0]:
    name = v1.0
    anchorfile = HCCG2.EXE
    anchordepth = 1
    file[]: crc = 0bee20a4; size =      4586; name = BLINKS.PRF
    file[]: crc = f337e482; size =   7722300; name = CARD.AVI
    file[]: crc = 66ffc870; size =  16998976; name = CARD.PRF
