//
// Demo
//
game[demo]:
    name = Demo
    launch = $(rootpath)\HCCG2D.EXE
    anchorfile = HCCG2D.EXE
    anchordepth = 1
    file[]: crc = 0bee20a4; size =      4586; name = BLINKS.PRF
    file[]: crc = 3380f3c2; size =        68; name = CARD.INI    ; optional = true
