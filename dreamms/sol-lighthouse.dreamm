addon[v2.0a-upgrade-en]:
    name = Upgrade to 2.0a
	imports = v2.0-upgrade-en
    upgradeids = [[[,
        v1.0c-en-dos
        v1.0c-en-win
        v1.1-en-dos
        v1.1-en-win
        v2.0-en-dos
        v2.0-en-win
