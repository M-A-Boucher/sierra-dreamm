//
// Lighthouse: The Dark Being
//
desc[sol-lighthouse]:

name = Lighthouse: The Dark Being
icon = sol-lighthouse.png
machine = pc
rootpath = C:\
launch = $(rootpath)\SIER.EXE $(rootpath)\RESOURCE.CFG   
osenv = dos
mips = $(MIPS_486DX2_50)
audiohw = sb16
ramkb = 16384
videohw = svga

//
// File System
//
mount[]: vpath = C:\        ; srcpath = $(ifsdeltapath)  ; writable = true
mount[]: vpath = $(rootpath); srcpath = $(ifsinstallpath)
mount[]: vpath = D:\        ; srcpath = $(ifsinstallpath); condition = is_game()

CFG = [[[$(CRLF)
    videoDrv   = VESA.DRV
    soundDrv   = MIDNONE.DRV
    audioDrv   = DACBLAST.DRV
    joyDrv     = NO
    directory  = .\
    cmd        = LIGHT
    mouseDrv   = NONE
    memoryDrv  = NONE
    minMemory  = 6000
    language   = 1
    minCPU     = 486
    maxSubmits = 15
    CD         = yes
    cacheSize3 = 100   
    resMap     = D:\
    resAUD     = D:\ 
    resSFX     = D:\ 
    movieDir   = D:\MOVIES 
    robot      = D:\ROBOTS 
    rescdisc   = D:\ 
    patchDir   = C:\;D:\patches      
]]]
          
WIN = [[[$(CRLF)
    [Windows]
    title=Lighthouse
    directory=Lightwin
    titleBar=TRUE
    maximized=TRUE
    colorcursor=TRUE
    allowresize=FALSE
    pagelock=FALSE
    showmem=FALSE
    wwidth=640
    wheight=480
    winAudioSize=63k
    maxCursorSize=5456
    asyncCheckFreq=175
    scimaxk=7000
    scimink=4000
    maxSubmits=12
    borderpixels=5
    monodisp=1
    useDirectSound=TRUE
    showMem=TRUE
    dacSize=8192
    cacheSize3=100
    resAud=CD:\
    resSfx=CD:\
    resMap=CD:\
    rescdisc=CD:\
    patchDir=C:\SIERRA\LIGHTWIN;CD:\PATCHES
    movieDir=CD:\MOVIES
    robot=CD:\ROBOTS
    discID=RESSCI
    CD:=D:
]]]


WIN_DEMO = [[[$(CRLF)
    [Windows]
    title=Lighthouse Demo
    directory=Litedemo
    titleBar=TRUE
    maximized=TRUE
    colorcursor=TRUE
    allowresize=FALSE
    pagelock=FALSE
    showmem=FALSE
    wwidth=640
    wheight=480
    winAudioSize=63k
    maxCursorSize=5456
    asyncCheckFreq=175
    scimaxk=7000
    scimink=4000
    maxSubmits=12
    borderpixels=5
    monodisp=1
    useDirectSound=TRUE
    showMem=TRUE
    dacSize=8192
    cacheSize3=100
    resAud=C:\SIERRA\LITEDEMO
    resSfx=C:\SIERRA\LITEDEMO
    resMap=C:\SIERRA\LITEDEMO
    patchDir=C:\SIERRA\LITEDEMO
    movieDir=C:\SIERRA\LITEDEMO
    robot=C:\SIERRA\LITEDEMO
    discID=RESSCI     
]]]

script[init]:
    code = [[[$(CRLF)
        if (is_dos())
          file_save("$$(rootpath)\\RESOURCE.CFG", "$$(CFG)");

        if (is_windows() && is_game())
          file_save("$$(rootpath)\\RESOURCE.WIN", "$$(WIN)");

        if (is_windows() && is_demo())
          file_save("$$(rootpath)\\RESOURCE.WIN", "$$(WIN_DEMO)");
    ]]]
end

//
// Fragment for Windows
//
fragment[win32-base]:
    osenv = windows
    rootpath = C:\SIERRA\LIGHTWIN
    launch = "$(rootpath)\SIERW5.EXE" $(rootpath)\RESOURCE.WIN
    audiohw = gmidi
    winres = 640x480x16
    mips = $(MIPS_MAX)
end

