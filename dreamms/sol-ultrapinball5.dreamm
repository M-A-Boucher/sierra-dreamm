//
// 3-D Ultra Pinball: Thrillride
//
desc[sol-ultrapinball5]:

name = 3-D Ultra Pinball: Thrillride
icon = sol-ultrapinball5.png
machine = pc
osenv = windows
winres = 800x600x16
rootpath = C:\
launch = $(rootpath)\Pinball.exe
audiohw = gmidi
filter = sierra, dynamix, pinball

script[init]:
    code = [[[$(CRLF)
        drive_set_label("D", "THRILLRIDE");
    ]]]
end

//
// file system
//
mount[]: vpath = C:\        ; srcpath = $(ifsdeltapath)     ; writable = true
mount[]: vpath = $(rootpath); srcpath = $(ifsinstallpath)
mount[]: vpath = D:\        ; srcpath = $(ifsinstallpath)\CD

//
// v1.0
//
game[v1.0]:
    name = v1.0
    anchorfile = Pinball.exe
    anchordepth = 2
