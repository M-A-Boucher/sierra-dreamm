//
// Time Warp of Dr. Brain
//
desc[sol-brain4]:

name = Time Warp of Dr. Brain
icon = sol-brain4.png
machine = pc
osenv = windows
rootpath = C:\
launch = $(rootpath)\DRBRAIN4.EXE
mips = $(MIPS_MAX)
audiohw = gmidi
winres = 640x480x8
filter = sierra, puzzle

//
// filesystem
//
mount[]: vpath = C:\        ; srcpath = $(ifsdeltapath)  ; writable = true;
mount[]: vpath = $(rootpath); srcpath = $(ifsinstallpath)

