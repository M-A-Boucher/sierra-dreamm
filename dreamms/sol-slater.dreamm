game[v1.0-int-5.19.93-3x1.44m]:
    name = v1.0, Int. 5.19.93, 3x1.44M
    imports = v1.0-base
    anchorfile = RESOURCE.000
    file[]: crc = abc326e1; size =   2256126; name = RESOURCE.000
