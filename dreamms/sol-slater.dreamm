    name = v1.0, Int. 5.19.93, 3x1.44M, Installer
    installid = v1.0-int-5.19.93-3x1.44m
    mips = $(MIPS_MAX)
    launch = DREAMM.BAT
    imports = v1.0-base
    anchorfile = AUDDCOMP.EXE
