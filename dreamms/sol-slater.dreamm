//
// Slater & Charlie Go Camping
//
desc[sol-slater]:

name = Slater & Charlie Go Camping
icon = sol-slater.png
machine = pc
osenv = dos
rootpath = C:\
mips = $(MIPS_486DX_33)
ramkb = 4096
audiohw = $(AUDIOHW)+$(SFX)
filter = sierra, adventure

//
// environment configuration
//
config[environment]:
    title = Environment Configuration
    condition = !is_installer()
    option[dos]: 
        name = DOS
        launch = $(rootpath)\SIERRA.EXE
        condition = file_exists("$$(rootpath)\\SIERRA.EXE")
    end
    option[win]:
        name = Windows
        osenv = windows 3.1
        audiohw = gmidi
        winres = 640x480x8
        launch = $(rootpath)\SIERRAW.EXE
        condition = file_exists("$$(rootpath)\\SIERRAW.EXE")
    end
end

//
// graphics configuration
//
config[graphics]:
    title = Graphics Configuration
    condition = is_dos()
    option[ega]:
        name = $(EGA_NAME)
        videohw = ega; priority = 1
        VIDEO_DRIVER = EGA640.DRV
        condition = file_exists("$$(rootpath)\\EGA640.DRV")
    end
    option[vgamono]:
        name = Monochrome $(VGA_NAME)
        videohw = vga
        VIDEO_DRIVER = VGA320BW.DRV
        condition = file_exists("$$(rootpath)\\VGA320BW.DRV")
    end
    option[vga]:
        name = $(VGA_NAME)
        videohw = vga;  priority = 2
        VIDEO_DRIVER = VGA320.DRV
        condition = file_exists("$$(rootpath)\\VGA320.DRV")
    end
end

//
// sound configuration
//
config[sound]:
    title = Sound Configuration
    condition = is_dos()
    option[speaker]:
        name = $(SPEAKER_NAME)
        SOUND_DRIVER = STD.DRV; AUDIOHW = speaker
        condition = file_exists("$$(rootpath)\\STD.DRV")
    end
    option[adlib]:
        name = $(ADLIB_NAME); priority = 1
        SOUND_DRIVER = ADL.DRV; AUDIOHW = adlib
        condition = file_exists("$$(rootpath)\\ADL.DRV")
    end
    option[sb16]:
        name = $(SB16_NAME); priority = 2
        SOUND_DRIVER = SBPRO.DRV; AUDIOHW = sb16
        condition = file_exists("$$(rootpath)\\SBPRO.DRV")
    end
    option[mt32]:
        name = $(MT32_NAME)
        SOUND_DRIVER = MT32.DRV; AUDIOHW = mt32
        condition = file_exists("$$(rootpath)\\MT32.DRV")
    end
    option[gmidi]:
        name = $(GMIDI_NAME)
        SOUND_DRIVER = GENMIDI.DRV; AUDIOHW = gmidi
        condition = file_exists("$$(rootpath)\\GENMIDI.DRV")
    end
end

//
// midi configuration
//
config[midi]:
    title = MIDI Configuration
    condition = is_windows()
    option[basesynth]:
        name = Base Synth (11-channel)
        SOUND_DRIVER = basesynth
    end
    option[highsynth]:
        name = High Synth (16-channel); priority = 1
        SOUND_DRIVER = highsynth
    end
end

//
// sfx configuration
//
config[sfx]:
    title = SFX Configuration
    condition = is_dos()
    option[on]:
        name = On
        AUDIO_DRIVER = AUDBLAST.DRV; SFX = sb16
        condition = file_exists("$$(rootpath)\\AUDBLAST.DRV")
    end
    option[off]:
        name = Off
        AUDIO_DRIVER = AUDNONE.DRV; SFX = $(NULL)
        condition = file_exists("$$(rootpath)\\AUDNONE.DRV")
    end
end

INSTALL = [[[$(CRLF)
    COPY RESOURCE.001+RESOURCE.002+RESOURCE.003 RESOURCE.000
    AUDDCOMP.EXE .\
]]]

CFG = [[[$(CRLF)
    videoDrv  = $(VIDEO_DRIVER)
    soundDrv  = $(SOUND_DRIVER)
    audioDrv  = $(AUDIO_DRIVER)
    joyDrv    = JOYSTICK.DRV
    kbdDrv    = IBMKBD.DRV
    mouseDrv  = STDMOUSE.DRV
    minHunk   = 204k
    audioSize = 12k
    language  = 1
    sync      = $(rootpath)
    audio     = $(rootpath)
    patchDir  = $(rootpath)
]]]

INI = [[[$(CRLF)
    [Info]
    title       = Slater Charlie Go Camping
    confirmdac  = TRUE
    confirmmidi = TRUE
    genmidi     = TRUE
    synthtype   = $(SOUND_DRIVER)
    audioBuffs  = 4
    resSfx      = $(rootpath)
    resMap      = $(rootpath)
    resAud      = $(rootpath)
    patchDir    = $(rootpath)
]]]

script[init]:
    code = [[[$(CRLF)
        if (is_installer())
          file_save("$$(rootpath)\\DREAMM.BAT", "$$(INSTALL)");

        if (is_game() && is_dos())
          file_save("$$(rootpath)\\RESOURCE.CFG", "$$(CFG)");

        if (is_game() && is_windows())
        {
          path_create("880.SCR");
          file_save("$$(rootpath)\\SIERRA.INI", "$$(INI)");
        }
    ]]]
end

//
// filesystem
//
mount[]: vpath = C:\        ; srcpath = $(ifsdeltapath)  ; writable = true;
mount[]: vpath = $(rootpath); srcpath = $(ifsinstallpath)

