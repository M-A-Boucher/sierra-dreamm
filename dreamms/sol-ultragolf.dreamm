//
// 3-D Ultra: MiniGolf
//
desc[sol-ultragolf]:

name = 3-D Ultra: MiniGolf
icon = sol-ultragolf.png
machine = pc
osenv = windows
winres = 800x600x32
rootpath = C:\
launch = $(rootpath)\MINIGOLF.EXE
audiohw = gmidi
filter = sierra, dynamix

//
// file system
//
mount[]: vpath = C:\        ; srcpath = $(ifsdeltapath)     ; writable = true
mount[]: vpath = $(rootpath); srcpath = $(ifsinstallpath)
mount[]: vpath = D:\        ; srcpath = $(ifsinstallpath)\CD; condition = file_exists("$$(rootpath)\\CD\\CDDA.SOU")

//
// v1.0
//
