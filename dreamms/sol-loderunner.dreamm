//
// Lode Runner: The Legend Returns
//
desc[sol-loderunner]:

name = Lode Runner: The Legend Returns
icon = sol-loderunner.png
machine = pc
osenv = dos
rootpath = C:\SIERRA
launch = $(rootpath)\LODERUNN.EXE
mips = $(MIPS_P100)
ramkb = 16384
audiohw = sb16+gmidi
filter = sierra, action

CFG = [[[$(CRLF)
    joyDrv    = NO
    mouseDrv  = STDMOUSE.DRV
    memoryDrv = ARM.DRV
    minCPU    = 386
    minDOS    = 500
    minEMS    = 2048
    mode      = real 
]]]

INSTALL = [[[$(CRLF)
    MD AUDIO
    UNCHUNK RESOURCE.000 .
    UNCHUNK RESOURCE.001 .
    UNCHUNK RESOURCE.002 .
    UNCHUNK RESOURCE.003 .
    UNCHUNK RESOURCE.004 .
    PRSADD LR256.PRS GENMID.PRS
    PRSADD LR16.PRS GENMID.PRS
    PRSADD LR256.PRS SOUND.PRS
]]]

INI = [[[$(CRLF)
    [environment]
    CDdrive=D
    CDinst=0
    resources=0000000002
    icon=Off

    [technology]
    display.drv=
    DibBlit=WinG
    WinGFound=1

    [symphonics]
    music=On
    sound=On
    volume=45056

    [help]
    balloon=On

    [player1]
    input=keys

    [player2]
    input=keys
]]]

script[init]:
    code = [[[$(CRLF)
        video_suppress(is_installer() && !is_windows());
        
        if (is_installer())
          file_save("$$(rootpath)\\DREAMM.BAT", "$$(INSTALL)");

        if (is_game() && is_dos())
          file_save("$$(rootpath)\\RESOURCE.CFG", "$$(CFG)");

        if (is_game() && is_windows())
          file_save("C:\\WINDOWS\\LODERUNN.INI", "$$(INI)");
    ]]]
end

script[autoinstall]:
    condition = is_installer() && is_windows()
    code = [[[
        keyboard_type("C:\\SIERRA\r", 500);
        keyboard_type("A:\\\r", 500);
        keyboard_type("\r", 500);
        // Now what?
    ]]]
end

//
// filesystem
//
mount[]: vpath = C:\        ; srcpath = $(ifsdeltapath)     ; writable = true;
mount[]: vpath = $(rootpath); srcpath = $(ifsinstallpath)
mount[]: vpath = D:\        ; srcpath = $(ifsinstallpath)\CD; condition = file_exists("$$(rootpath)\\CD\\CDDA.SOU")

