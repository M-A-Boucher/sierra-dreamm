//
// Quest for Glory V: Dragon Fire
//
desc[sol-qfg5]:

name = Quest for Glory V: Dragon Fire
icon = sol-qfg5.png
machine = pc
rootpath = C:\SIERRA\QFG5
launch = "$(rootpath)\QFG5.exe"
osenv = windows 98
audiohw = gmidi
winres = 1024x768x16
filter = sierra, adventure, action

//
// filesystem
//
mount[]: vpath = C:\;         srcpath = $(ifsdeltapath); writable = true
mount[]: vpath = $(rootpath); srcpath = $(ifsinstallpath)
mount[]: vpath = D:\        ; srcpath = $(ifsinstallpath)\CD; condition = is_game()

//
// initialization script
//
script[init]:
    code = [[[$(CRLF)
        file_save("$$(rootpath)\\Qfg5.cfg", "`h:44 0D 0A 1A");
    ]]]
end

